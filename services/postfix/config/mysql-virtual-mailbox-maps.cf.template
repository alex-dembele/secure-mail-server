# ============================================
# MySQL Virtual Mailbox Maps
# Query virtual mailboxes from database
# Returns mailbox path for user
# ============================================

user = ${DB_USER}
password = ${DB_PASSWORD}
hosts = ${DB_HOST}:${DB_PORT}
dbname = ${DB_NAME}
query = SELECT CONCAT(SUBSTRING_INDEX(email,'@',-1),'/',SUBSTRING_INDEX(email,'@',1),'/') FROM users WHERE email='%s' AND active=1