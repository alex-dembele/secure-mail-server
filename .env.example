# ============================================
# Mailserver Environment Configuration
# Copy this file to .env and customize
# ============================================

# ============================================
# General Settings
# ============================================
MAILSERVER_VERSION=1.0.0
TZ=UTC
LOG_LEVEL=INFO

# ============================================
# Docker Registry
# ============================================
REGISTRY=ghcr.io/your-org
REGISTRY_USERNAME=your-username
# REGISTRY_PASSWORD=your-token  # Set via environment or secrets

# ============================================
# Docker Build Settings
# ============================================
PLATFORMS=linux/amd64,linux/arm64
BUILDER_NAME=mailserver-builder
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ============================================
# Database Configuration
# ============================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mailserver
DB_USER=mailserver_app
DB_PASSWORD=change_me_in_production
DB_ROOT_PASSWORD=change_me_root_password

# Wait for database on startup
WAIT_FOR_HOST=mysql
WAIT_FOR_PORT=3306
WAIT_TIMEOUT=60

# ============================================
# Mail Domains
# ============================================
PRIMARY_DOMAIN=example.com
ADDITIONAL_DOMAINS=test.local,demo.org

# ============================================
# SMTP Configuration
# ============================================
SMTP_HOST=0.0.0.0
SMTP_PORT=25
SMTP_SUBMISSION_PORT=587
SMTP_TLS_PORT=465

# ============================================
# IMAP/POP3 Configuration
# ============================================
IMAP_PORT=143
IMAPS_PORT=993
POP3_PORT=110
POP3S_PORT=995

# ============================================
# TLS/SSL Configuration
# ============================================
TLS_ENABLED=true
TLS_CERT_PATH=/etc/mailserver/tls/cert.pem
TLS_KEY_PATH=/etc/mailserver/tls/key.pem
# For Let's Encrypt
ACME_EMAIL=admin@example.com
ACME_STAGING=false

# ============================================
# DKIM Configuration
# ============================================
DKIM_SELECTOR=mail
DKIM_KEY_SIZE=2048

# ============================================
# Rspamd Configuration
# ============================================
RSPAMD_CONTROLLER_PASSWORD=change_me_rspamd
RSPAMD_ENABLE_LEARNING=true
RSPAMD_SPAM_THRESHOLD=15

# ============================================
# ClamAV Configuration
# ============================================
CLAMAV_ENABLED=true
CLAMAV_UPDATE_FREQUENCY=daily

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Quota Configuration
# ============================================
DEFAULT_QUOTA_GB=5
DEFAULT_MESSAGE_LIMIT=10000

# ============================================
# Admin API Configuration
# ============================================
API_PORT=8080
API_SECRET_KEY=change_me_very_long_random_string
API_ENABLE_CORS=true
API_CORS_ORIGINS=http://localhost:3000,https://mail.example.com

# ============================================
# Web UI Configuration
# ============================================
WEB_UI_PORT=3000
WEB_UI_API_URL=http://admin-api:8080

# ============================================
# Backup Configuration
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# S3-compatible backup storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=mailserver-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ============================================
# Monitoring Configuration
# ============================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# ============================================
# Logging Configuration
# ============================================
# Levels: DEBUG, INFO, WARN, ERROR
LOG_FORMAT=json
ENABLE_AUDIT_LOG=true

# Elasticsearch/Opensearch for logs
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ============================================
# Security Settings
# ============================================
# Rate limiting
RATE_LIMIT_ENABLED=true
MAX_CONNECTIONS_PER_IP=10
MAX_EMAILS_PER_HOUR=100

# Anti-spam
SPAM_FILTER_ENABLED=true
SPAM_QUARANTINE_ENABLED=true

# Anti-virus
VIRUS_SCAN_ENABLED=true

# ============================================
# Development Settings (disable in production)
# ============================================
DEBUG_MODE=false
ENABLE_TEST_ENDPOINTS=false
DISABLE_TLS_VERIFICATION=false

# ============================================
# Feature Flags
# ============================================
ENABLE_WEBMAIL=true
ENABLE_CALDAV=true
ENABLE_CARDDAV=true
ENABLE_SIEVE=true
ENABLE_VACATION=true
ENABLE_FORWARDING=true
ENABLE_ALIASES=true
ENABLE_SHARED_MAILBOXES=true

# ============================================
# Performance Tuning
# ============================================
WORKER_PROCESSES=auto
MAX_MAIL_SIZE_MB=50
CONNECTION_TIMEOUT=300
MAIL_QUEUE_LIFETIME_DAYS=5

# ============================================
# Kubernetes-specific (if deploying to K8s)
# ============================================
K8S_NAMESPACE=mail
K8S_STORAGE_CLASS=standard
K8S_INGRESS_CLASS=nginx